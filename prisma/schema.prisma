// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // --- System admin ---
  globalRole      SystemRole @default(STANDARD)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  suspendedAt     DateTime?
  suspendedById   String?
  suspendedReason String?

    // === Hồ sơ cá nhân ===
  title     String?
  phone     String?
  timezone  String?  @default("Asia/Ho_Chi_Minh")
  bio       String?
  links     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // next-auth
  accounts Account[]
  sessions Session[]

  // --- Back-relations ---
  organizations        OrganizationMember[]
  projectMemberships   ProjectMember[]
  projectsCreated      Project[]             @relation("ProjectCreator")
  projectsLed          Project[]             @relation("ProjectLead")
  tasksCreated         Task[]                @relation("TaskCreatedBy")
  tasksUpdated         Task[]                @relation("TaskUpdatedBy")
  taskAssignments      TaskAssignee[]
  comments             TaskComment[]
  commentMentions      CommentMention[]
  resources            Resource[]
  attachmentsAdded     TaskAttachment[]
  notifications        Notification[] // từ Notification.recipient
  notificationSettings NotificationSetting[]
  timeEntries          TimeEntry[]
  dailyReports         DailyReport[]
  activities           ActivityLog[] // từ ActivityLog.actor

  // tích hợp / backup / audit
  integrationsCreated Integration[]    @relation("IntegrationCreatedBy")
  integrationsUpdated Integration[]    @relation("IntegrationUpdatedBy")
  backupsStarted      BackupSnapshot[] @relation("BackupStartedBy")
  backupsFinished     BackupSnapshot[] @relation("BackupFinishedBy")
  auditLogs           AuditLog[] // từ AuditLog.actor
   projectInvitesSent     ProjectInvite[] @relation("InvitedByUser") // user mời người khác
  projectInvitesReceived ProjectInvite[] @relation("RecipientUser") // user được mời
  
    sprintsCreated Sprint[] @relation("SprintCreatedBy")

  // ai khóa tài khoản này (self-relation)
  suspendedBy    User?           @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers User[]          @relation("UserSuspendedBy")
  SystemSetting  SystemSetting[]

  @@index([globalRole])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// ---------- ENU M S ----------
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

enum SystemRole {
  SYS_ADMIN // toàn quyền nền tảng
  SYS_SUPPORT // hỗ trợ kỹ thuật (chỉ đọc cấu hình, xem log)
  STANDARD // người dùng thường (mặc định)
}

enum UserStatus {
  ACTIVE
  SUSPENDED // bị khóa
  INVITED // mời nhưng chưa kích hoạt
  DELETED // xóa mềm (giữ lịch sử)
}

enum ProjectRole {
  MANAGER // full quyền dự án
  LEAD // lead kỹ thuật/nhóm
  MEMBER // thành viên thực thi
  REVIEWER // chỉ review/duyệt
  VIEWER // chỉ xem
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResourceType {
  FILE
  LINK
  REPO // git repo
  SERVER // máy chủ test/staging
}

enum DependencyType {
  BLOCKS
  RELATES
  DUPLICATES
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  DEADLINE_SOON
  MENTION
  PROJECT_INVITE
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  MEMBER_ADDED
  MEMBER_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  FILE_ATTACHED
}

// ---------- TỔ CHỨC / ĐƠN VỊ ----------
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]

  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------- DỰ ÁN ----------
model Project {
  id             String    @id @default(cuid())
  organizationId String
  key            String    @unique // ví dụ: ITPM
  name           String
  description    String?
  status         String    @default("active") // active/archived
  startDate      DateTime?
  dueDate        DateTime?
  leadId         String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invites ProjectInvite[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?        @relation("ProjectLead", fields: [leadId], references: [id])
  createdBy    User         @relation("ProjectCreator", fields: [createdById], references: [id])

  members             ProjectMember[]
  columns             BoardColumn[]
  tasks               Task[]
  sprints             Sprint[]
  milestones          Milestone[]
  resources           Resource[]
  events              CalendarEvent[]
  activities          ActivityLog[]
  notifications       Notification[]
  Tag                 Tag[]
  NotificationSetting NotificationSetting[]
  DailyReport         DailyReport[]

  @@index([organizationId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ---------- KANBAN ----------
model BoardColumn {
  id        String  @id @default(cuid())
  projectId String
  name      String
  order     Int     @default(0) // để sắp xếp cột
  isDefault Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, order])
}

// ---------- TASK ----------
model Task {
  id            String     @id @default(cuid())
  projectId     String
  columnId      String?
  sprintId      String?
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(MEDIUM)
  points        Int?
  estimateHours Decimal?   @db.Decimal(6, 2)
  startDate     DateTime?
  dueDate       DateTime?
  order         Int? // vị trí trong cột Kanban
  createdById   String
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  sprint    Sprint?      @relation(fields: [sprintId], references: [id])
  createdBy User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedBy User?        @relation("TaskUpdatedBy", fields: [updatedById], references: [id])

  assignees        TaskAssignee[]
  tags             TaskTag[]
  comments         TaskComment[]
  attachments      TaskAttachment[]
  dependenciesFrom TaskDependency[] @relation("FromTask")
  dependenciesTo   TaskDependency[] @relation("ToTask")
  events           CalendarEvent[]
  activities       ActivityLog[]
  timeEntries      TimeEntry[]
  Notification     Notification[]

  @@index([projectId, status, priority])
  @@index([columnId, order])
  @@index([sprintId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Tag {
  id        String @id @default(cuid())
  projectId String
  name      String
  slug      String

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTag[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String // markdown/plaintext
  parentId  String? // reply/thread
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   TaskComment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies  TaskComment[]    @relation("CommentThread")
  mentions CommentMention[]

  attachments TaskAttachment[]
}

model CommentMention {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  resourceId String
  addedById  String
  addedAt    DateTime @default(now())

  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  addedBy       User         @relation(fields: [addedById], references: [id], onDelete: Cascade)
  TaskComment   TaskComment? @relation(fields: [taskCommentId], references: [id])
  taskCommentId String?

  @@index([taskId])
}

model TaskDependency {
  id         String         @id @default(cuid())
  fromTaskId String
  toTaskId   String
  type       DependencyType @default(BLOCKS)

  from Task @relation("FromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  to   Task @relation("ToTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
}

// ---------- SPRINT / MILESTONE / LỊCH ----------
model Sprint {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  goal       String?
  startDate  DateTime
  endDate    DateTime
  status     String   @default("active")

  // NEW – audit
  createdById String?
  createdBy   User?   @relation("SprintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, startDate, endDate])
  @@index([projectId, status])
}


model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime
  status      String   @default("open") // open/achieved/closed

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  CalendarEvent[]

  @@index([projectId, dueDate])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String?
  milestoneId String?
  provider    String? // "google", "outlook"...
  externalId  String? // id sự kiện bên ngoài
  summary     String
  description String?
  start       DateTime
  end         DateTime
  createdAt   DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([projectId, start, end])
}

// ---------- TÀI NGUYÊN (file/link/repo/server) ----------
model Resource {
  id          String       @id @default(cuid())
  projectId   String
  type        ResourceType
  name        String
  url         String? // link, repo, server URL
  // Nếu dùng S3/MinIO
  bucket      String?
  objectKey   String?
  mimeType    String?
  size        Int?
  createdById String
  createdAt   DateTime     @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attachments TaskAttachment[]

  @@index([projectId, type])
}

// ---------- THÔNG BÁO ----------
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  projectId   String?
  taskId      String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])

  @@index([recipientId, readAt])
}

model NotificationSetting {
  id          String  @id @default(cuid())
  userId      String
  projectId   String? // null = áp dụng toàn cục
  email       Boolean @default(true)
  push        Boolean @default(true)
  silentStart Int? // giờ bắt đầu "quiet hours" (0-23)
  silentEnd   Int?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ---------- TIME TRACKING & BÁO CÁO ----------
model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, userId, startedAt])
}

model DailyReport {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  date      DateTime
  done      String? // Hôm qua đã làm gì
  doing     String? // Hôm nay làm gì
  blockers  String? // Vướng mắc
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, authorId, date])
  @@index([projectId, date])
}

// ---------- ACTIVITY FEED ----------
model ActivityLog {
  id        String       @id @default(cuid())
  projectId String?
  taskId    String?
  actorId   String
  type      ActivityType
  message   String?
  meta      Json?
  createdAt DateTime     @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor   User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

// Cặp key/value cấu hình hệ thống (SMTP, Slack, Zalo, bảo mật...)
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique // ví dụ: SMTP_CONFIG, SLACK_WEBHOOK
  value       Json? // lưu JSON cấu hình
  isSecret    Boolean  @default(false) // nếu là thông tin nhạy cảm
  updatedById String?
  updatedAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// Thông tin tích hợp ngoài (nếu muốn tách riêng từng provider)
enum IntegrationProvider {
  EMAIL
  SLACK
  ZALO
  GOOGLE_CALENDAR
  GITHUB
}

model Integration {
  id          String              @id @default(cuid())
  provider    IntegrationProvider
  name        String
  enabled     Boolean             @default(true)
  config      Json // token/endpoint/… (khuyên mã hóa ở app)
  createdById String?
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  createdBy User? @relation("IntegrationCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("IntegrationUpdatedBy", fields: [updatedById], references: [id])

  @@index([provider, enabled])
}

// Audit log toàn hệ thống (khác với ActivityLog ở mức dự án)
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "USER_SUSPEND", "ROLE_UPDATE", "BACKUP_RESTORE"
  entityType String? // "User","SystemSetting","Project",...
  entityId   String?
  ip         String?
  userAgent  String?
  details    Json? // diff, payload, lỗi...
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Theo dõi backup/restore (lưu ở MinIO/S3/local)
enum BackupStatus {
  PENDING
  SUCCESS
  FAILED
}

enum StorageProvider {
  MINIO
  S3
  LOCAL
}

model BackupSnapshot {
  id           String          @id @default(cuid())
  status       BackupStatus    @default(PENDING)
  storage      StorageProvider @default(MINIO)
  location     String
  sizeBytes    BigInt?         @db.BigInt
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  startedById  String?
  finishedById String?
  notes        String?

  startedBy  User? @relation("BackupStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  finishedBy User? @relation("BackupFinishedBy", fields: [finishedById], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
}

enum InviteStatus { 
  PENDING 
  ACCEPTED 
  REVOKED 
  EXPIRED 
  }



model ProjectInvite {
  id           String       @id @default(cuid())
  projectId    String
  // KHÔNG dùng email nữa:
  recipientId  String       // user được mời
  role         ProjectRole  @default(MEMBER)
  token        String       @unique
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime?
  invitedById  String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: SetNull)
  recipient    User         @relation("RecipientUser", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectId, status])
  @@index([recipientId, status])
}
