{
  "compilerOptions": {
    "noImplicitAny": false,
    "baseUrl": ".",
    "outDir": ".next/types",
    // NOTE: `ignoreDeprecations` can break Next.js worker startup in some envs.
    // Remove or adjust if `Invalid value for '--ignoreDeprecations'` appears.
    //"ignoreDeprecations": "5.0",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "prisma/seed.js"
  ],
  "exclude": ["node_modules"]
}
